# Formspree form ID for the email waitlist (free tier: formspree.io)
# Add the same variable in Vercel → Project → Settings → Environment Variables
VITE_FORMSPREE_ID=your_formspree_id_here

# OpenRouter — server-only (never use VITE_ prefix; never expose in frontend)
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Optional — shown in OpenRouter rankings
# OPENROUTER_SITE_URL=https://demo-moradia-ufsc.vercel.app
# OPENROUTER_SITE_NAME=Moradias UFSC

# --- Vercel deployment (free Hobby tier) ---
# Framework: Vite | Build: npm run build | Output: dist
# After push, verify: https://YOUR_DOMAIN/api/listings and POST /api/rerank
# Local dev: run `npm run dev:api` in one terminal, `npm run dev` in another
